# Job Finder – Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# ADZUNA (required if using Adzuna job source)
# Sign up: https://developer.adzuna.com/signup
# =============================================================================
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# =============================================================================
# ARBEITSAGENTUR (Germany – no signup required)
# Uses fixed client ID. Leave as-is unless instructed otherwise.
# Docs: https://jobsuche.api.bund.dev/
# =============================================================================
ARBEITSAGENTUR_CLIENT_ID=jobboerse-jobsuche

# =============================================================================
# ARBEITNOW (Europe & remote – no API key required)
# Docs: https://documenter.getpostman.com/view/18545278/UVJbJdKh
# =============================================================================
# No credentials needed. Enable in config if/when supported.

# =============================================================================
# OLLAMA (local AI – runs on your machine)
# Install: https://ollama.com | Docs: https://docs.ollama.com/
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# =============================================================================
# PATHS (optional overrides)
# =============================================================================
CV_INPUT_DIR=./cv_input
OUTPUT_DIR=./output

# =============================================================================
# JOB SEARCH (optional overrides)
# Adzuna country codes: de, at, ch, fr, it, gb, us, etc.
# =============================================================================
